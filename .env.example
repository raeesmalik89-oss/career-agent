# Copy to .env and fill in. NEVER commit .env.
# Generate JWT_SECRET and MASTER_KEY with:  uv run python -m app.cli gen-keys   (or: make keys)
# Every setting is described in docs/DEPLOYMENT.md.

APP_ENV=development
# Local Windows use: sqlite:///storage/dev.db   Docker: set by docker-compose.yml (PostgreSQL)
DATABASE_URL=sqlite:///storage/dev.db

JWT_SECRET=change-me-run-gen-keys
MASTER_KEY=change-me-run-gen-keys
MASTER_KEY_VERSION=1

# Must be true when served over HTTPS (the production override sets it)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
LOGIN_RATE_LIMIT_PER_MINUTE=5
TIMEZONE=Asia/Karachi

# Optional: create the first owner on startup (for hosts without shell access, e.g. Render free).
# Set both, deploy once, then log in. Idempotent: ignored once that user exists. See DEPLOY.md.
# BOOTSTRAP_OWNER_EMAIL=you@example.com
# BOOTSTRAP_OWNER_PASSWORD=          # 12+ characters
# BOOTSTRAP_OWNER_NAME=Your Name

# Optional
# LOG_LEVEL=INFO
# LOG_FORMAT=json            # or text
# MAX_REQUEST_MB=25
# BACKUP_KEEP=14             # SQLite backups kept in storage/backups
# METRICS_TOKEN=             # required to scrape /metrics from another host (16+ characters)

# Docker Compose only
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me
POSTGRES_DB=career_agent
# APP_VERSION=1.0.0          # image tag

# Production override (deploy/docker-compose.prod.yml) only
# DOMAIN=careers.example.com
# ACME_EMAIL=you@example.com

# Not used yet (the agents are deterministic). Store user tokens through the dashboard, not here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
