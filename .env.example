# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  make keys   (or: uv run python -m app.cli gen-keys)

APP_ENV=development
DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career_agent
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-run-make-keys
MASTER_KEY=change-me-run-make-keys
MASTER_KEY_VERSION=1

# Must be true when served over HTTPS (always in production)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
LOGIN_RATE_LIMIT_PER_MINUTE=5
TIMEZONE=Asia/Karachi

# Used only by docker-compose for the postgres container
POSTGRES_USER=career
POSTGRES_PASSWORD=career
POSTGRES_DB=career_agent

# Later milestones (leave empty for now). Store user tokens via the API, not here, when possible.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
